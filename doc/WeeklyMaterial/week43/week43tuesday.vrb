\frametitle{Case 1: the code you should end up with}
\begin{columns}[T]
\begin{column}{0.5\textwidth}
\begin{lstlisting}
def confusion_matrix(y, yhat):
    tp = np.sum((y == 1) & (yhat == 1))
    fn = np.sum((y == 1) & (yhat == 0))
    fp = np.sum((y == 0) & (yhat == 1))
    tn = np.sum((y == 0) & (yhat == 0))
    return tp, fn, fp, tn

def roc_curve(y, s):
    order = np.argsort(-s, kind="mergesort")
    y, s = y[order], s[order]
    tp = np.cumsum(y == 1)
    fp = np.cumsum(y == 0)
    last = np.r_[np.diff(s) != 0, True]
    tpr = np.r_[0.0, tp[last] / tp[-1]]
    fpr = np.r_[0.0, fp[last] / fp[-1]]
    return fpr, tpr, np.r_[np.inf, s[last]]

def roc_auc(y, s):            # P(pos > neg)
    _, inv, cnt = np.unique(
        s, return_inverse=True, return_counts=True)
    first = np.cumsum(cnt) - cnt + 1
    ranks = (first + (cnt - 1) / 2)[inv]
    n_pos = np.sum(y == 1)
    n_neg = len(y) - n_pos
    S = np.sum(ranks[y == 1])
    S -= n_pos * (n_pos + 1) / 2
    return S / (n_pos * n_neg)
\end{lstlisting}
\end{column}
