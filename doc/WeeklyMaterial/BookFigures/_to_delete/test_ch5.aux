\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces The computational graph of the cross entropy of one observation, trace\nobreakspace  {}(\ref  {eq:5-adtrace}). The inputs are the two parameters; the data $x$ and $y$ enter as constants on the edges. The linear predictor $z=v_2$ fans out into the softplus branch along the top and the label branch along the bottom, and the reverse sweep of Eq.\nobreakspace  {}(\ref  {eq:5-adreverse}) sums the two when it reaches $v_2$, producing the residual $p-y$.}}{16}{figure.5.5}\protected@file@percent }
\newlabel{fig:5-logreggraph}{{5.5}{16}{The computational graph of the cross entropy of one observation, trace~(\ref {eq:5-adtrace}). The inputs are the two parameters; the data $x$ and $y$ enter as constants on the edges. The linear predictor $z=v_2$ fans out into the softplus branch along the top and the label branch along the bottom, and the reverse sweep of Eq.~(\ref {eq:5-adreverse}) sums the two when it reaches $v_2$, producing the residual $p-y$}{figure.5.5}{}}
