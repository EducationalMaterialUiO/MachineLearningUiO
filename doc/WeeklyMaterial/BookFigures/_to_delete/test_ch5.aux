\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Excess cross entropy $C(\bm  {\theta })-C(\hat  {\bm  {\theta }})$ against passes over the data for the logistic regression problem of Section\nobreakspace  {}\ref  {sec:logregsgdvsgd} ($n=50\,000$, $p=20$, $\kappa =173$). Gradient descent uses the learning rate\nobreakspace  {}(\ref  {eq:5-gdstability}); the SGD runs use minibatches of $M=32$, the cost being recorded ten times per epoch, at three constant learning rates and with the decaying schedule $\gamma _t=0.1\cdot 10^{3}/(t+10^{3})$. The dotted line is the excess cost of the parameters that generated the data, about $p/(2n)$. After a single epoch every SGD run is where gradient descent is after twenty. The constant-rate runs then equilibrate in a cloud whose size grows with $\gamma $, as Eq.\nobreakspace  {}(\ref  {eq:4-sgdcloud}) predicts, the smallest rate reaching within twenty epochs the level gradient descent needs two hundred for; only the decaying schedule continues downwards.}}{21}{figure.5.6}\protected@file@percent }
\newlabel{fig:5-sgdvsgd}{{5.6}{21}{Excess cross entropy $C(\bm {\theta })-C(\hat {\bm {\theta }})$ against passes over the data for the logistic regression problem of Section~\ref {sec:logregsgdvsgd} ($n=50\,000$, $p=20$, $\kappa =173$). Gradient descent uses the learning rate~(\ref {eq:5-gdstability}); the SGD runs use minibatches of $M=32$, the cost being recorded ten times per epoch, at three constant learning rates and with the decaying schedule $\gamma _t=0.1\cdot 10^{3}/(t+10^{3})$. The dotted line is the excess cost of the parameters that generated the data, about $p/(2n)$. After a single epoch every SGD run is where gradient descent is after twenty. The constant-rate runs then equilibrate in a cloud whose size grows with $\gamma $, as Eq.~(\ref {eq:4-sgdcloud}) predicts, the smallest rate reaching within twenty epochs the level gradient descent needs two hundred for; only the decaying schedule continues downwards}{figure.5.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.9.3}AdaGrad, RMSProp and Adam on the same problem}{22}{subsection.5.9.3}\protected@file@percent }
\newlabel{sec:logregadaptive}{{5.9.3}{22}{AdaGrad, RMSProp and Adam on the same problem}{subsection.5.9.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces Plain SGD, AdaGrad, RMSProp and Adam, all with $M=32$ and each at the best of five constant learning rates, against gradient descent at the learning rate\nobreakspace  {}(\ref  {eq:5-gdstability}), on the logistic regression problem of Section\nobreakspace  {}\ref  {sec:logregsgdvsgd}. Left: standardised features, $\kappa =173$. Right: the same data with each feature column multiplied by a random factor between $0.1$ and $10$, which raises the condition number of the Hessian at the optimum to $4.4\times 10^{4}$ and the excess cost of the two plain-gradient methods by nearly two orders of magnitude, while the three adaptive methods lose less than one. On standardised features the four stochastic methods are indistinguishable after ten epochs.}}{22}{figure.5.7}\protected@file@percent }
\newlabel{fig:5-adaptive}{{5.7}{22}{Plain SGD, AdaGrad, RMSProp and Adam, all with $M=32$ and each at the best of five constant learning rates, against gradient descent at the learning rate~(\ref {eq:5-gdstability}), on the logistic regression problem of Section~\ref {sec:logregsgdvsgd}. Left: standardised features, $\kappa =173$. Right: the same data with each feature column multiplied by a random factor between $0.1$ and $10$, which raises the condition number of the Hessian at the optimum to $4.4\times 10^{4}$ and the excess cost of the two plain-gradient methods by nearly two orders of magnitude, while the three adaptive methods lose less than one. On standardised features the four stochastic methods are indistinguishable after ten epochs}{figure.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Excess cross entropy $C(\bm  {\theta })-C(\hat  {\bm  {\theta }})$ and training accuracy for the methods of Figure\nobreakspace  {}\ref  {fig:5-adaptive}, from the output of the listing below. Gradient descent is listed after $200$ epochs, the stochastic methods after $20$; the column ``mean'' averages the excess cost at the ends of epochs $15$ to $20$, which smooths the fluctuations of the constant-rate runs. The excess cost of the parameters that generated the data is $2.7\times 10^{-4}$ in both cases.}}{23}{table.5.1}\protected@file@percent }
\newlabel{tab:5-sgdcompare}{{5.1}{23}{Excess cross entropy $C(\bm {\theta })-C(\hat {\bm {\theta }})$ and training accuracy for the methods of Figure~\ref {fig:5-adaptive}, from the output of the listing below. Gradient descent is listed after $200$ epochs, the stochastic methods after $20$; the column ``mean'' averages the excess cost at the ends of epochs $15$ to $20$, which smooths the fluctuations of the constant-rate runs. The excess cost of the parameters that generated the data is $2.7\times 10^{-4}$ in both cases}{table.5.1}{}}
